# Copy this file to .env for local development, or set these as environment
# variables in your hosting provider's dashboard (Render, Railway, Fly, etc.)
# for production. Never commit a real .env file.

# Port the server listens on. Most hosts (Render, Railway) set this for you
# automatically — only set it yourself for local dev / self-hosting.
PORT=3001

# Postgres connection string. Get this from your database provider
# (Neon, Render Postgres, Railway Postgres, Supabase, etc.)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret and never reuse it across environments.
SESSION_SECRET=

# Set to "production" when deployed. Enables secure (HTTPS-only) cookies.
NODE_ENV=production

# Comma-separated list of origins allowed to call this API with credentials.
# Required for the GitHub Pages setup (see DEPLOYMENT.md) since the frontend
# and backend are on different domains there — no same-origin proxy option
# exists on GitHub Pages the way it did on Netlify. Example:
# CORS_ORIGIN=https://your-username.github.io
CORS_ORIGIN=

# Required as "none" for the GitHub Pages setup (cross-origin cookies need
# this, plus HTTPS which both GitHub Pages and Render provide automatically).
# Only use "lax" if frontend and backend end up served from the same site.
COOKIE_SAMESITE=none

# Firebase Authentication (server-side token verification).
# From Firebase Console > Project settings > Service accounts > Generate new
# private key. Paste the ENTIRE downloaded JSON file contents as a single-line
# string here (most hosts' env var UIs handle multi-line values fine too —
# just paste the whole JSON object as-is either way).
# Leave unset to disable Firebase sign-in (the app falls back to running
# without it — existing email/password accounts, if any, still work).
# See DEPLOYMENT.md for the full setup walkthrough.
FIREBASE_SERVICE_ACCOUNT=
