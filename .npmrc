auto-install-peers=false
strict-peer-dependencies=false
# Netlify (and other CI hosts) run their own automatic dependency-install
# step before any custom build command even runs, and that step defaults
# to --frozen-lockfile in CI. This setting is what actually reaches that
# step (a build-command flag doesn't, since it runs too late) — it lets
# pnpm update pnpm-lock.yaml in place instead of failing when it's out of
# sync with package.json. Safe to remove once the lockfile has been
# regenerated locally (`pnpm install`) and committed.
frozen-lockfile=false
